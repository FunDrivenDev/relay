# relay notifier check: the handover plugin's notifier report, read through
# handover.py notifier (a fake python3 prints the canned report of each
# environment).

exec sh -c 'cp fake-python3 bin/python3 && chmod +x bin/python3 && mkdir -p "$HOME/.claude/plugins" "$WORK/plugin/scripts" && touch "$WORK/plugin/scripts/handover.py" && sed "s|@WORK@|$WORK|" installed.json >"$HOME/.claude/plugins/installed_plugins.json"'

# A Linux desktop with notify-send: reaches you, no hints.
cp linux.json report.json
exec relay notifier check
cmp stdout linux.txt
! stderr .
exec relay notifier check --json
cp stdout flags.json
exec relay notifier check --json='{}'
cmp stdout flags.json
cmp flags.json linux-out.json
grep '^python3 handover.py notifier$' stubs.log

# macOS: osascript.
cp macos.json report.json
exec relay notifier check
stdout '^environment  macos, desktop \(macOS\)$'
stdout '^adapters     osascript, bell$'
stdout '^✓ alerts reach you$'

# Headless, over SSH: only the bell, the plugin's hints and the guide.
cp ssh.json report.json
exec relay notifier check
cmp stdout ssh.txt
exec relay notifier check --json
stdout '"reaches_you": false'
stdout '"ssh": true'

# WSL, with notify_command set: reaches you through the command.
cp wsl.json report.json
exec relay notifier check
stdout '^environment  wsl, headless \(WSL: notify-send reaches no Windows desktop\)$'
stdout '^notifier     auto \(notify_command set\)$'
stdout '^adapters     command, bell$'
! stdout 'guide'

# Read-only: no --dry-run; --help --json describes the output.
exits 2 relay notifier check --dry-run
stderr 'unknown option: --dry-run'
exec relay notifier check --help --json
stdout '"output": "\{\\"environment\\": \{\\"os\\", \\"desktop\\", \\"ssh\\", \\"why\\", \\"tools\\"\}'

# No plugin: relay_missing; no python3: tool_missing.
rm bin/python3
exits 1 relay notifier check --json
stderr '"code":"tool_missing"'
rm home/.claude/plugins/installed_plugins.json
exits 1 relay notifier check --json
stderr '"code":"relay_missing"'

-- installed.json --
{"version": 2, "plugins": {"handover@fundrivendev": [{"installPath": "@WORK@/plugin", "version": "0.16.0"}]}}
-- fake-python3 --
#!/bin/sh
# A fake python3 running handover.py notifier: prints report.json, with
# "sent" from sent.txt under --test; logs the call.
printf 'python3' >>"$WORK/stubs.log"
for a in "$@"; do printf ' %s' "${a##*/}" >>"$WORK/stubs.log"; done
echo >>"$WORK/stubs.log"
[ "$2" = notifier ] || exit 2
if [ "${3:-}" = --test ]; then
	sed "s/}\$/, \"sent\": $(cat "$WORK/sent.txt")}/" "$WORK/report.json"
else
	cat "$WORK/report.json"
fi
echo 'handover: a hint on stderr' >&2
-- linux.json --
{"environment": {"os": "linux", "desktop": true, "ssh": false, "why": "a Linux desktop session", "tools": {"osascript": null, "notify-send": "/usr/bin/notify-send"}}, "notifier": "auto", "notify_command_set": false, "adapters": ["notify-send", "bell"], "reaches_you": true, "hints": []}
-- macos.json --
{"environment": {"os": "macos", "desktop": true, "ssh": false, "why": "macOS", "tools": {"osascript": "/usr/bin/osascript", "notify-send": null}}, "notifier": "auto", "notify_command_set": false, "adapters": ["osascript", "bell"], "reaches_you": true, "hints": []}
-- ssh.json --
{"environment": {"os": "linux", "desktop": false, "ssh": true, "why": "over SSH, without a display", "tools": {"osascript": null, "notify-send": null}}, "notifier": "auto", "notify_command_set": false, "adapters": ["bell"], "reaches_you": false, "hints": ["over SSH, without a display: only the bell rings; set notify_command (Slack, ntfy…) to be reached", "options: /handover:config, or: claude plugin configure handover@fundrivendev; guide: https://github.com/FunDrivenDev/claude-plugins/blob/main/plugins/handover/docs/notifications.md"]}
-- wsl.json --
{"environment": {"os": "wsl", "desktop": false, "ssh": false, "why": "WSL: notify-send reaches no Windows desktop", "tools": {"osascript": null, "notify-send": "/usr/bin/notify-send"}}, "notifier": "auto", "notify_command_set": true, "adapters": ["command", "bell"], "reaches_you": true, "hints": []}
-- linux.txt --
environment  linux, desktop (a Linux desktop session)
notifier     auto (notify_command not set)
adapters     notify-send, bell
✓ alerts reach you
-- linux-out.json --
{
  "environment": {
    "os": "linux",
    "desktop": true,
    "ssh": false,
    "why": "a Linux desktop session",
    "tools": {
      "notify-send": "/usr/bin/notify-send",
      "osascript": null
    }
  },
  "notifier": "auto",
  "notify_command_set": false,
  "adapters": [
    "notify-send",
    "bell"
  ],
  "reaches_you": true,
  "hints": []
}
-- ssh.txt --
environment  linux, headless, over SSH (over SSH, without a display)
notifier     auto (notify_command not set)
adapters     bell
! only the terminal bell rings: alerts may not reach you
  over SSH, without a display: only the bell rings; set notify_command (Slack, ntfy…) to be reached
  options: /handover:config, or: claude plugin configure handover@fundrivendev; guide: https://github.com/FunDrivenDev/claude-plugins/blob/main/plugins/handover/docs/notifications.md
