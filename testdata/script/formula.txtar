# scripts/formula.sh: the Homebrew formula of a release, from dist/checksums.txt.

exec bash $REPO/scripts/formula.sh v1.2.3
cmp stdout relay.rb
! stderr .

# Usage errors: no version, not a version.
! exec bash $REPO/scripts/formula.sh
stderr '^usage: formula.sh <version>$'
! exec bash $REPO/scripts/formula.sh latest
stderr 'latest is not a version X.Y.Z'

# An archive missing from the checksums, then no checksums at all.
exec sh -c 'grep -v arm64 dist/checksums.txt >amd64.txt && mv amd64.txt dist/checksums.txt'
! exec bash $REPO/scripts/formula.sh 1.2.3
stderr 'relay_linux_arm64.tar.gz is not in dist/checksums.txt'
! stdout .
rm dist/checksums.txt
! exec bash $REPO/scripts/formula.sh 1.2.3
stderr 'no dist/checksums.txt'

-- dist/checksums.txt --
1111111111111111111111111111111111111111111111111111111111111111  relay_1.2.3_amd64.deb
aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa  relay_linux_amd64.tar.gz
bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb  relay_linux_arm64.tar.gz
-- relay.rb --
# The formula of relay, generated by relay's scripts/formula.sh from the
# checksums of its v1.2.3 release.
class Relay < Formula
  desc "Claude Code sessions under tmux, with the handover relay and AFK runs"
  homepage "https://github.com/FunDrivenDev/relay"
  version "1.2.3"
  license "MIT"

  depends_on :linux
  depends_on "tmux"

  on_linux do
    on_arm do
      url "https://github.com/FunDrivenDev/relay/releases/download/v#{version}/relay_linux_arm64.tar.gz"
      sha256 "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    end
    on_intel do
      url "https://github.com/FunDrivenDev/relay/releases/download/v#{version}/relay_linux_amd64.tar.gz"
      sha256 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    end
  end

  def install
    bin.install "relay"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/relay --version")
  end
end
